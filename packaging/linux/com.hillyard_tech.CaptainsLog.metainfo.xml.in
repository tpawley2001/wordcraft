<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.hillyard_tech.CaptainsLog</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Captain's Log</name>
  <summary>Write and design documents; open and save Word files</summary>
  <!-- Brand values mirror crates/engine/src/brand.rs. -->
  <developer id="com.hillyard_tech">
    <name>Hillyard Tech</name>
  </developer>
  <description>
    <p>
      Captain's Log, the word processor of Jolly Roger Office, is a fast, open-source word processor with a familiar ribbon: styles, tables, track changes, references, mail merge, and .docx, PDF, ODT, RTF, HTML and Markdown files. It can be driven by AI agents over MCP. Based on WordCraft by the ArtCraft team (MIT OR Apache-2.0).
    </p>
  </description>
  <launchable type="desktop-id">com.hillyard_tech.CaptainsLog.desktop</launchable>
  <icon type="stock">com.hillyard_tech.CaptainsLog</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://hillyard-tech.com/</url>
  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>
  <keywords>
    <keyword>word processor</keyword>
    <keyword>docx</keyword>
    <keyword>document</keyword>
    <keyword>writer</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#F4E9D0</color>
    <color type="primary" scheme_preference="dark">#1F3A4D</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <!-- Document types Captain's Log opens (#295), as in the desktop entry's MimeType=. -->
  <provides>
    <binary>wordcraft</binary>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.document</mediatype>
    <mediatype>application/vnd.ms-word.document.macroEnabled.12</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.template</mediatype>
    <mediatype>application/vnd.ms-word.template.macroEnabled.12</mediatype>
    <mediatype>application/msword</mediatype>
    <mediatype>application/msword-template</mediatype>
    <mediatype>application/vnd.oasis.opendocument.text</mediatype>
    <mediatype>application/rtf</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
